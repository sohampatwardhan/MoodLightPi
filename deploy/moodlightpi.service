[Unit]
Description=MoodLightPi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=RUST_LOG=info
Environment=MLP_BIND=0.0.0.0:80
# MLP_HOST is optional (comma-separated extra allowed Host values); LAN hosts
# (private IPs, *.local, bare hostnames, localhost) are accepted automatically.
ExecStart=/usr/local/bin/moodlightpi
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
