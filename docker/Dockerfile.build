# ARMv6 (Pi Zero W) builder — runs NATIVELY on arm64 (Apple Silicon) and amd64,
# no `cross`, no QEMU emulation. Produces an arm-unknown-linux-gnueabihf binary.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git \
        gcc-arm-linux-gnueabihf libc6-dev-armhf-cross \
        clang libclang-dev \
    && rm -rf /var/lib/apt/lists/*

# Rust via rustup + the ARMv6 hard-float target (rustc emits +v6,+vfp2 for it).
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustup target add arm-unknown-linux-gnueabihf

# Cross-compile config: use the armhf gcc as linker + C compiler, and force
# ARMv6 codegen for the vendored rs_ws281x C library (Debian's armhf gcc
# defaults to ARMv7, which the Pi Zero's ARM1176 cannot run).
ENV CARGO_TARGET_ARM_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc \
    CC_arm_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc \
    CFLAGS_arm_unknown_linux_gnueabihf="-march=armv6 -mfpu=vfp -mfloat-abi=hard" \
    BINDGEN_EXTRA_CLANG_ARGS_arm_unknown_linux_gnueabihf="--target=arm-linux-gnueabihf -march=armv6"

WORKDIR /work
